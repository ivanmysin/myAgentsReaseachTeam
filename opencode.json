{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "zotero": {
      "type": "local",
      "command": ["opencode-zotero-mcp"],
      "enabled": true
    }
  },
  "agent": {
    "Sophia": {
      "mode": "primary",
      "description": "Универсальный научный ИИ-ассистент для работы с локальной Zotero-библиотекой. Координирует поиск литературы, глубокое чтение, синтез и написание научных текстов. Специализация пользователя подгружается из user_profile.md.",
      "color": "#1FFF64",
      "prompt": "{file:./.opencode/prompts/Sophia.txt}",
      "temperature": 0.3,
      "tools": {
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "grep *": "allow"
        }
      }
    },

    "searcher": {
      "mode": "subagent",
      "description": "Поиск релевантных статей в Zotero-библиотеке. Использует zotero_search_library (по метаданным и тегам), zotero_search_fulltext (по полным текстам), zotero_get_collections (навигация по коллекциям). Возвращает ранжированный список статей с обоснованием релевантности.",
      "prompt": "{file:./.opencode/agents/searcher.md}",
      "model": "{env:SEARCHER_MODEL}",
      "temperature": 0.1,
      "tools": {
        "edit": true,
        "bash": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "grep *": "allow"
        }
      }
    },

    "reader": {
      "mode": "subagent",
      "description": "Глубокое чтение конкретных статей из Zotero-библиотеки. Извлекает метаданные, абстракты, полные тексты и аннотации пользователя. Создаёт структурированные конспекты с цитатами и числовыми данными.",
      "prompt": "{file:./.opencode/agents/reader.md}",
      "model": "{env:READER_MODEL}",
      "temperature": 0.3,
      "tools": {
        "edit": true,
        "bash": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "grep *": "allow"
        }
      }
    },

    "synthesizer": {
      "mode": "subagent",
      "description": "Синтез информации из множества конспектов статей. Выявляет общие паттерны, противоречия, пробелы в знаниях. Создаёт структурированные обзоры, сравнительные таблицы и аргументационные цепочки.",
      "prompt": "{file:./.opencode/agents/synthesizer.md}",
      "model": "{env:SYNTHESIZER_MODEL}",
      "temperature": 0.5,
      "tools": {
        "edit": true,
        "bash": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "grep *": "allow"
        }
      }
    },

    "writer": {
      "mode": "subagent",
      "description": "Написание финальных научных текстов: введения, обсуждения, обзоры, протоколы, презентации. Академический стиль с корректным цитированием. Язык вывода зависит от задачи и специализации пользователя.",
      "prompt": "{file:./.opencode/agents/writer.md}",
      "model": "{env:WRITER_MODEL}",
      "temperature": 0.7,
      "tools": {
        "edit": true,
        "bash": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "ls *": "allow",
          "mkdir *": "allow",
          "grep *": "allow"
        }
      }
    }
  }
}
